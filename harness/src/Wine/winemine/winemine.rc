#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDM_WINEMINE MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New\tF2",       IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Mark Question", IDM_MARKQ
        MENUITEM SEPARATOR
        MENUITEM "&Beginner",      IDM_BEGINNER
        MENUITEM "&Advanced",      IDM_ADVANCED
        MENUITEM "&Expert",        IDM_EXPERT
        MENUITEM "&Custom...",     IDM_CUSTOM
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+X",   IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Fastest Times...", IDM_TIMES
        MENUITEM "&About WineMine",   IDM_ABOUT
    END
END

DLG_TIMES DIALOG 0, 0, 160, 100
STYLE DS_MODALFRAME | DS_3DLOOK | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Fastest Times"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX    "Fastest Times", -1, 10, 10, 140, 55
    LTEXT       "Beginner:", -1, 20, 22, 40, 8
    LTEXT       "Advanced:", -1, 20, 34, 40, 8
    LTEXT       "Expert:",   -1, 20, 46, 40, 8
    LTEXT       "999", IDC_TIME1, 65, 22, 20, 8
    LTEXT       "999", IDC_TIME2, 65, 34, 20, 8
    LTEXT       "999", IDC_TIME3, 65, 46, 20, 8
    LTEXT       "Nobody", IDC_NAME1, 90, 22, 55, 8
    LTEXT       "Nobody", IDC_NAME2, 90, 34, 55, 8
    LTEXT       "Nobody", IDC_NAME3, 90, 46, 55, 8
    PUSHBUTTON  "&Reset", IDC_RESET, 20, 72, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 90, 72, 50, 14
END

DLG_CONGRATS DIALOG 0, 0, 160, 60
STYLE DS_MODALFRAME | DS_3DLOOK | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Congratulations!"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Please enter your name", -1, 10, 10, 140, 10
    EDITTEXT IDC_EDITNAME, 10, 24, 140, 12, WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 60, 42, 40, 14
END

DLG_CUSTOM DIALOG 0, 0, 160, 100
STYLE DS_MODALFRAME | DS_3DLOOK | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Custom Field"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Rows:", -1, 15, 15, 40, 10
    LTEXT "Columns:", -1, 15, 35, 40, 10
    LTEXT "Mines:", -1, 15, 55, 40, 10
    EDITTEXT IDC_EDITROWS, 65, 13, 30, 12, WS_BORDER | WS_TABSTOP
    EDITTEXT IDC_EDITCOLS, 65, 33, 30, 12, WS_BORDER | WS_TABSTOP
    EDITTEXT IDC_EDITMINES, 65, 53, 30, 12, WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 110, 12, 40, 14
    PUSHBUTTON "Cancel", IDCANCEL, 110, 32, 40, 14
END

STRINGTABLE
BEGIN
    IDS_APPNAME, "WineMine"
    IDS_NOBODY,  "Nobody"
    IDS_ABOUT,   "WineMine (C) 2000 Joshua Thielen"
    IDC_CONFIRMTITLE, "Reset Results"
    IDC_CONFIRMTEXT,  "Are you sure you want to reset all high scores?"
END

IDA_WINEMINE ACCELERATORS
BEGIN
    VK_F2, IDM_NEW, VIRTKEY
    "X", IDM_EXIT, VIRTKEY, ALT
END
